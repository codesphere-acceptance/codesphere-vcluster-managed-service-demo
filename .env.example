# Copy to .env.local (gitignored) and fill in CS_TOKEN. direnv loads this so the
# `cs` CLI and tools/*.sh can talk to the Codesphere team over the Public API.
#
#   cp .env.example .env.local && direnv allow

# Codesphere Public API base URL (include the trailing /api).
# Example instance (adjust for your Codesphere deployment):
CS_API=https://csa.codesphere-demo.com/api

# Team that owns this demo. Both are accepted: the `cs` CLI uses CS_TEAM_ID;
# tools/providers.sh accepts either CS_TEAM_ID or CS_TEAM_NAME.
CS_TEAM_NAME="Team A1"
CS_TEAM_ID=91

# Personal Access Token — Codesphere > Account Settings > API Keys.
# Never commit the filled-in .env.local; it holds a live token.
CS_TOKEN=
